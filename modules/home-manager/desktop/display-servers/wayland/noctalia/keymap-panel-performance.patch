+
+local function schedulePanelStep(fn)
+  table.insert(Fast.steps, fn)
+  Fast.stepCounter += 1
+  noctalia.state.set(PANEL_STEP_KEY, Fast.stepCounter)
+end
+
+noctalia.state.watch(PANEL_STEP_KEY, function(_value)
+  local fn = table.remove(Fast.steps, 1)
+  if fn ~= nil then fn() end
+end)
+
+local function scheduleFill()
+  if Fast.fillQueued then return end
+  Fast.fillQueued = true
+  schedulePanelStep(function()
+    Fast.fillQueued = false
+    if not Fast.renderTruncated then return end
+    Fast.renderLimit += Fast.renderStep
+    if Fast.render ~= nil then
+      Fast.render()
+    end
+  end)
+end
 
