#!/bin/sh

set -eu

light_locker_pid=
light_locker_started=0

start_light_locker() {
	command -v light-locker >/dev/null 2>&1 || return 0

	if command -v pgrep >/dev/null 2>&1 &&
		pgrep -u "$(id -u)" -x light-locker >/dev/null 2>&1; then
		return 0
	fi

	light-locker >/dev/null 2>&1 &
	light_locker_pid=$!
	light_locker_started=1
	if command -v sleep >/dev/null 2>&1; then
		sleep "${DWM_LOCK_START_DELAY:-0.2}"
	fi
}

stop_started_light_locker() {
	[ "$light_locker_started" = 1 ] || return 0
	[ -n "$light_locker_pid" ] || return 0

	kill "$light_locker_pid" 2>/dev/null || true
	wait "$light_locker_pid" 2>/dev/null || true
	light_locker_pid=
	light_locker_started=0
}

stop_started_light_locker_after_unlock() {
	[ "$light_locker_started" = 1 ] || return 0
	[ -n "$light_locker_pid" ] || return 0
	command -v sleep >/dev/null 2>&1 || return 0

	(
		active_seen=0
		attempts=0
		while kill -0 "$light_locker_pid" 2>/dev/null; do
			locker_state=$(LC_ALL=C light-locker-command --query 2>/dev/null || true)
			case $locker_state in
			*" is active") active_seen=1 ;;
			*" is inactive")
				if [ "$active_seen" = 1 ]; then
					kill "$light_locker_pid" 2>/dev/null || true
					exit 0
				fi
				;;
			esac

			attempts=$((attempts + 1))
			if [ "$active_seen" = 0 ] && [ "$attempts" -ge 30 ]; then
				kill "$light_locker_pid" 2>/dev/null || true
				exit 0
			fi
			sleep 1
		done
	) >/dev/null 2>&1 &
}

try_lock() {
	"$@" >/dev/null 2>&1
}

# 1. Betterlockscreen (i3lock-color com blur do wallpaper e Catppuccin Mocha)
if command -v betterlockscreen >/dev/null 2>&1; then
	# Se ainda não existe cache do wallpaper, tenta gerar a partir de diretórios conhecidos
	if [ ! -d "$HOME/.cache/betterlockscreen" ]; then
		wp=""
		for candidate in "$HOME/Pictures/backgrounds" "$HOME/.dotfiles/assets/wallpapers" "/usr/share/backgrounds"; do
			if [ -d "$candidate" ]; then
				wp=$(find "$candidate" -type f \( -name "*.jpg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | head -n 1 || true)
				[ -n "$wp" ] && break
			fi
		done
		if [ -n "$wp" ]; then
			betterlockscreen -u "$wp" >/dev/null 2>&1 || true
		fi
	fi

	# Trava com dimblur e cores Catppuccin Mocha
	if try_lock betterlockscreen -l dimblur -- \
		--insidecolor=1e1e2e00 \
		--ringcolor=cba6f7ff \
		--keyhlcolor=a6e3a1ff \
		--bshlcolor=f38ba8ff \
		--separatorcolor=00000000 \
		--insidevercolor=89b4fa00 \
		--ringvercolor=b4befeff \
		--insidewrongcolor=f38ba800 \
		--ringwrongcolor=eba0acff \
		--timecolor=cdd6f4ff \
		--datecolor=a6adc8ff \
		--linecolor=00000000; then
		exit 0
	fi
	if try_lock betterlockscreen -l; then
		exit 0
	fi
fi

# 2. i3lock / i3lock-color direto
for locker in i3lock-color i3lock; do
	if command -v "$locker" >/dev/null 2>&1; then
		if try_lock "$locker" -c 1e1e2e; then
			exit 0
		fi
	fi
done

# 3. Light-Locker (integração nativa com LightDM)
if command -v light-locker-command >/dev/null 2>&1; then
	start_light_locker
	if try_lock light-locker-command --lock; then
		stop_started_light_locker_after_unlock
		exit 0
	fi
	stop_started_light_locker
fi

# 4. Outros gerenciadores de screensaver X11
if command -v xdg-screensaver >/dev/null 2>&1 &&
	try_lock xdg-screensaver lock; then
	exit 0
fi

if [ "${DWM_LOCK_NO_LOGINCTL:-0}" != 1 ] &&
	command -v loginctl >/dev/null 2>&1; then
	if [ -n "${XDG_SESSION_ID:-}" ]; then
		if try_lock loginctl lock-session "$XDG_SESSION_ID"; then
			exit 0
		fi
	elif try_lock loginctl lock-session; then
		exit 0
	fi
fi

if command -v mate-screensaver-command >/dev/null 2>&1 &&
	try_lock mate-screensaver-command --lock; then
	exit 0
fi

if command -v xfce4-screensaver-command >/dev/null 2>&1 &&
	try_lock xfce4-screensaver-command --lock; then
	exit 0
fi

if command -v cinnamon-screensaver-command >/dev/null 2>&1 &&
	try_lock cinnamon-screensaver-command --lock; then
	exit 0
fi

if command -v gnome-screensaver-command >/dev/null 2>&1 &&
	try_lock gnome-screensaver-command --lock; then
	exit 0
fi

for locker in slock xlock; do
	if command -v "$locker" >/dev/null 2>&1 &&
		try_lock "$locker"; then
		exit 0
	fi
done

printf '%s\n' \
	'dwm-lock: no usable screen locker found.' \
	'Install betterlockscreen, i3lock, light-locker or another supported locker.' >&2
exit 1
