# MIME types supported by MPV for media association
[
  # Vídeo - MPEG Transport Stream (.ts, .m2t)
  # Nota: No freedesktop/shared-mime-info, a extensão .ts é historicamente associada
  # a text/vnd.trolltech.linguist ("Message catalog" do Qt Linguist).
  # Mapeamos também ao MPV para que esses arquivos de vídeo abram diretamente
  # no player pelo gerenciador de arquivos sem disparar erro de permissão no mimeapps.list.
  "video/mp2t"
  "video/ts"
  "video/vnd.dlna.mpeg-tts"
  "text/vnd.trolltech.linguist"
  "application/x-linguist"

  # Vídeo - Matroska / MKV (.mkv)
  "video/x-matroska"
  "video/mkv"
  "application/x-matroska"
  "application/mkv"

  # Vídeo - MP4 / M4V (.mp4, .m4v)
  "video/mp4"
  "video/mp4v-es"
  "video/x-m4v"
  "application/x-extension-mp4"

  # Vídeo - WebM (.webm)
  "video/webm"

  # Vídeo - AVI (.avi)
  "video/x-msvideo"
  "video/avi"
  "video/msvideo"
  "video/vnd.avi"

  # Vídeo - QuickTime (.mov, .qt)
  "video/quicktime"

  # Vídeo - MPEG (.mpg, .mpeg, .m2v)
  "video/mpeg"
  "video/mpeg2"
  "video/x-mpeg"
  "video/x-mpeg2"
  "video/x-mpeg3"
  "video/mpv"
  "video/mpeg-system"

  # Vídeo - OGG / Theora / OGM (.ogv, .ogg, .ogm)
  "video/ogg"
  "video/x-ogm"
  "video/x-ogm+ogg"
  "video/x-theora"
  "video/x-theora+ogg"
  "application/ogg"
  "application/x-ogg"

  # Vídeo - Flash Video (.flv, .f4v)
  "video/x-flv"
  "video/flv"

  # Vídeo - Windows Media Video (.wmv, .asf)
  "video/x-ms-wmv"
  "video/x-ms-asf"
  "video/x-ms-asx"
  "video/x-ms-wvx"

  # Vídeo - 3GP / 3GPP (.3gp, .3g2)
  "video/3gpp"
  "video/3gpp2"

  # Vídeo - DivX (.divx)
  "video/divx"
  "video/vnd.divx"

  # Vídeo - DV & RealMedia (.dv, .rm, .rmvb)
  "video/dv"
  "video/x-dv"
  "video/vnd.rn-realmedia"

  # Vídeo - Streams e Playlists HLS / MPEG-URL (.m3u, .m3u8)
  "video/vnd.mpegurl"
  "application/vnd.apple.mpegurl"

  # Áudio - MP3 / MPEG Audio (.mp3)
  "audio/mp3"
  "audio/x-mp3"
  "audio/mpeg"
  "audio/x-mpeg"
  "audio/mpg"
  "audio/x-mpg"
  "audio/mpeg3"
  "audio/x-mpeg3"
  "audio/mp1"
  "audio/x-mp1"
  "audio/mp2"
  "audio/x-mp2"

  # Áudio - FLAC (.flac)
  "audio/flac"
  "audio/x-flac"

  # Áudio - OGG / Vorbis / Opus (.ogg, .oga, .opus)
  "audio/ogg"
  "audio/x-ogg"
  "audio/vorbis"
  "audio/x-vorbis"
  "audio/x-vorbis+ogg"
  "audio/opus"
  "audio/x-opus"

  # Áudio - WAV (.wav)
  "audio/wav"
  "audio/x-wav"
  "audio/wave"
  "audio/x-pn-wav"

  # Áudio - AAC / M4A / MP4 Audio (.aac, .m4a, .mp4)
  "audio/aac"
  "audio/x-aac"
  "audio/m4a"
  "audio/x-m4a"
  "audio/mp4"
  "application/x-extension-m4a"

  # Áudio - Matroska Audio (.mka) & WebM Audio (.weba)
  "audio/x-matroska"
  "audio/webm"

  # Áudio - Windows Media Audio (.wma)
  "audio/x-ms-wma"
  "audio/x-ms-wax"
  "audio/x-ms-asf"

  # Áudio - AIFF (.aiff, .aif)
  "audio/aiff"
  "audio/x-aiff"

  # Áudio - Formatos lossless adicionais (APE, WavPack, Musepack)
  "audio/ape"
  "audio/x-ape"
  "audio/wavpack"
  "audio/x-wavpack"
  "audio/musepack"
  "audio/x-musepack"

  # Áudio - RealAudio (.ra, .ram)
  "audio/vnd.rn-realaudio"

  # Áudio - Playlists (.m3u, .m3u8, .pls)
  "audio/mpegurl"
  "audio/x-mpegurl"
  "audio/x-scpls"
]
