<?xml version="1.0" encoding="UTF-8"?>
<!--
Dracula Theme for Gedit / GtkSourceView
https://github.com/dracula/gedit
-->
<style-scheme id="dracula" _name="Dracula" version="1.0" kind="dark">
  <_description>A dark theme for Gedit and GtkSourceView</_description>

  <!-- Dracula Palette -->
  <color name="background" value="#282a36"/>
  <color name="current-line" value="#44475a"/>
  <color name="selection" value="#44475a"/>
  <color name="foreground" value="#f8f8f2"/>
  <color name="comment" value="#6272a4"/>
  <color name="cyan" value="#8be9fd"/>
  <color name="green" value="#50fa7b"/>
  <color name="orange" value="#ffb86c"/>
  <color name="pink" value="#ff79c6"/>
  <color name="purple" value="#bd93f9"/>
  <color name="red" value="#ff5555"/>
  <color name="yellow" value="#f1fa8c"/>

  <!-- Helper colors -->
  <color name="white" value="#ffffff"/>
  <color name="bone-white" value="#f8f8f0"/>
  <color name="weird-gray" value="#909194"/>

  <!-- Global Settings -->
  <style name="text" foreground="foreground" background="background"/>
  <style name="selection" foreground="white" background="selection"/>
  <style name="cursor" foreground="white" background="white"/>
  <style name="secondary-cursor" foreground="white"/>
  <style name="current-line" background="current-line"/>
  <style name="line-numbers" foreground="weird-gray" background="background"/>
  <style name="draw-spaces" foreground="weird-gray"/>
  <style name="background-pattern" background="background"/>

  <!-- Bracket Matching -->
  <style name="bracket-match" foreground="bone-white" background="background" underline="true"/>
  <style name="bracket-mismatch" foreground="white" background="red"/>

  <!-- Right Margin -->
  <style name="right-margin" foreground="weird-gray" background="background"/>

  <!-- Search Matching -->
  <style name="search-match" foreground="white" background="selection"/>

  <!-- Comments -->
  <style name="def:comment" foreground="comment" italic="true"/>
  <style name="def:shebang" foreground="comment" bold="true"/>
  <style name="def:doc-comment-element" italic="true"/>

  <!-- Constants -->
  <style name="def:constant" foreground="purple"/>
  <style name="def:special-char" foreground="pink"/>
  <style name="def:special-constant" foreground="purple"/>
  <style name="def:string" foreground="yellow"/>
  <style name="def:character" foreground="yellow"/>
  <style name="def:number" foreground="purple"/>
  <style name="def:boolean" foreground="purple"/>
  <style name="def:floating-point" foreground="purple"/>

  <!-- Identifiers -->
  <style name="def:identifier" foreground="pink"/>
  <style name="def:function" foreground="green"/>

  <!-- Statements -->
  <style name="def:statement" foreground="pink"/>
  <style name="def:keyword" foreground="pink"/>
  <style name="def:operator" foreground="pink"/>

  <!-- Types -->
  <style name="def:type" foreground="cyan"/>
  <style name="def:builtin" foreground="cyan"/>

  <!-- Markup -->
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:inline-code" foreground="yellow"/>
  <style name="def:insertion" underline="single"/>
  <style name="def:deletion" strikethrough="true"/>
  <style name="def:link-text" foreground="cyan"/>
  <style name="def:link-symbol" foreground="purple" bold="true"/>
  <style name="def:link-destination" foreground="cyan" italic="true" underline="single"/>
  <style name="def:heading" foreground="purple" bold="true"/>
  <style name="def:thematic-break" foreground="green" bold="true"/>
  <style name="def:preformatted-section" foreground="yellow"/>
  <style name="def:list-marker" foreground="cyan" bold="true"/>

  <!-- Others -->
  <style name="def:preprocessor" foreground="pink"/>
  <style name="def:error" foreground="white" background="red" bold="true"/>
  <style name="def:warning" foreground="background" background="orange"/>
  <style name="def:note" foreground="background" background="yellow" bold="true"/>
  <style name="def:specials" foreground="bone-white"/>
  <style name="def:net-address" italic="true" underline="single"/>
</style-scheme>
