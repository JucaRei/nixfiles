{
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nil",
  "nix.formatterPath": "nixfmt",
  "nix.serverSettings": {
    "nil": {
      "formatting": {
        "command": [
          "nixfmt"
        ]
      }
    }
  },
  "direnv.restart.automatic": true,
  "direnv.status.showChangesCount": false,
  "editor.fontSize": 25,
  "editor.lineHeight": 1.4,
  "editor.tabSize": 2,
  "editor.lineNumbers": "on",
  "editor.renderWhitespace": "trailing",
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 140,
  "editor.wrappingIndent": "indent",
  "editor.cursorSurroundingLines": 1.2,
  "editor.cursorWidth": 1.6,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.cursorSurroundingLinesStyle": "all",
  "editor.smoothScrolling": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "diffEditor.experimental.showMoves": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.maxComputationTime": 0,
  "editor.find.autoFindInSelection": "multiline",
  "editor.fontFamily": "'Liga SFMono Nerd Font Italic', 'FiraCode Nerd Font', 'JetbrainsMono Nerd Font SemiBold Italic', 'SauceCodePro Nerd Font Propo Regular Italic', 'Droid Sans Mono'",
  "editor.fontLigatures": true,
  "editor.fontVariations": true,
  "editor.fontWeight": 500,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.guides.indentation": true,
  "editor.inlineSuggest.enabled": true,
  "editor.largeFileOptimizations": true,
  "editor.minimap.autohide": true,
  "editor.minimap.maxColumn": 100,
  "editor.renderControlCharacters": true,
  "editor.quickSuggestionsDelay": 1,
  "editor.roundedSelection": true,
  "editor.rulers": [
    100,
    140
  ],
  "editor.scrollbar.horizontal": "auto",
  "editor.scrollbar.vertical": "auto",
  "search.followSymlinks": false,
  "search.searchEditor.doubleClickBehaviour": "goToLocation",
  "search.smartCase": true,
  "search.sortOrder": "default",
  "editor.stickyScroll.defaultModel": "indentationModel",
  "editor.stickyScroll.enabled": false,
  "editor.stickyScroll.maxLineCount": 3,
  "editor.stickyScroll.scrollWithEditor": false,
  "editor.stickyTabStops": true,
  "editor.suggest.localityBonus": true,
  "editor.suggestSelection": "first",
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.incrementalNaming": "smart",
  "explorer.sortOrderLexicographicOptions": "default",
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "extensions.ignoreRecommendations": true,
  "files.autoGuessEncoding": true,
  "files.autoSave": "afterDelay",
  "files.enableTrash": false,
  "files.eol": "\n",
  "files.exclude": {
    "**/*.exe": true,
    "**/*.o": true,
    "**/*.olean": true,
    "**/.DS_Store": true,
    "**/.classpath": true,
    "**/.direnv": true,
    "**/.factorypath": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.svn": true,
    "**/CVS": true,
    "**/Thumbs.db": true
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "git.allowForcePush": true,
  "git.autofetch": true,
  "git.confirmSync": true,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",
  "remote.SSH.defaultExtensions": [
    "davidbwaters.macos-modern-theme",
    "tombonnike.vscode-status-bar-format-toggle",
    "natqe.reload",
    "RedCrafter07.red-theme",
    "jnoortheen.nix-ide",
    "jeff-hykin.better-nix-syntax",
    "oderwat.indent-rainbow"
  ],
  "remote.SSH.useLocalServer": false,
  "security.promptForLocalFileProtocolHandling": false,
  "security.workspace.trust.enabled": false,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 1.8,
  "terminal.integrated.fontFamily": "'FiraCode Nerd Font Mono', 'monospace'",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.mouseWheelScrollSensitivity": 2,
  "terminal.integrated.persistentSessionScrollback": 200,
  "terminal.integrated.scrollback": 5000,
  "terminal.integrated.cursorStyleInactive": "block",
  "terminal.integrated.showExitAlert": false,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.tabs.focusMode": "singleClick",
  "update.mode": "none",
  "update.showReleaseNotes": true,
  "window.autoDetectColorScheme": true,
  "window.commandCenter": false,
  "window.density.editorTabHeight": "compact",
  "window.menuBarVisibility": "toggle",
  "window.title": "${rootName}${separator}${profileName}${separator}${activeEditorShort}",
  "window.titleBarStyle": "custom",
  "window.zoomLevel": 0.3,
  "workbench.colorTheme": "RedCrafter07 Theme",
  "workbench.editor.labelFormat": "short",
  "workbench.enableExperiments": true,
  "workbench.iconTheme": "simple-icons",
  "workbench.preferredDarkColorTheme": "RedCrafter07 Theme",
  "workbench.productIconTheme": "macos-modern",
  "workbench.settings.editor": "ui",
  "workbench.settings.enableNaturalLanguageSearch": true,
  "workbench.tree.indent": 4,
  "workbench.colorCustomizations": {
    // "[RedCrafter07 Theme]": {
    //   "[Pop Dark]": {
    //     "tab.activeBackground": "#372f92"
    //   }
    // },
    "editor.background": "#1e1e2e",
    "tab.activeBackground": "#1e1e2e",
    "tab.inactiveBackground": "#181825",
    "editorGroupHeader.tabsBackground": "#11111b"
  },
  "zenMode.hideLineNumbers": false
}